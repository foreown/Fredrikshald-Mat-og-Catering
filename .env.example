# =============================================================================
# Fredrikshald Mat & Catering UB — miljøvariabler
# =============================================================================
# Kopier denne filen til `.env.local` når du utvikler lokalt.
# I produksjon legger du de samme variablene inn i Vercel
# (Project Settings -> Environment Variables).
#
# .env.local skal ALDRI lastes opp til GitHub. Den er allerede i .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# PÅKREVD — Supabase
# -----------------------------------------------------------------------------
# Finner du i Supabase: Project Settings -> API (eller Data API).
#
# NEXT_PUBLIC_SUPABASE_URL
#   Adressen til Supabase-prosjektet ditt.
#   Ser slik ut: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Den offentlige "anon"-nøkkelen (heter noen ganger "publishable key").
#   Denne er laget for å ligge i nettleseren og er trygg å eksponere —
#   sikkerheten ligger i Row Level Security i databasen.
#   Lang tekststreng som starter med eyJ... (eller sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key-her


# -----------------------------------------------------------------------------
# ANBEFALT — Nettadressen til siden
# -----------------------------------------------------------------------------
# Brukes til SEO: canonical-lenker, sitemap.xml og Open Graph-bilder.
# Skriv full adresse uten skråstrek på slutten.
# Settes du ikke denne, faller siden tilbake på Vercel-adressen automatisk.
NEXT_PUBLIC_SITE_URL=https://fredrikshald-mat-catering.vercel.app


# -----------------------------------------------------------------------------
# ANBEFALT — Spam-beskyttelse for anmeldelser (kun server)
# -----------------------------------------------------------------------------
# En hemmelig, tilfeldig tekst som brukes til å hashe IP-adresser før de
# lagres. Da kan vi begrense antall anmeldelser per besøkende uten å lagre
# selve IP-adressen. Lag en tilfeldig verdi, f.eks. med:
#   openssl rand -base64 32
#
# MERK: Denne har IKKE NEXT_PUBLIC_ foran seg. Det betyr at den kun finnes
# på serveren og aldri sendes til nettleseren. Sånn skal det være.
REVIEW_IP_SALT=bytt-meg-til-en-lang-tilfeldig-tekst


# =============================================================================
# ADVARSEL
# =============================================================================
# Legg ALDRI inn SUPABASE_SERVICE_ROLE_KEY i dette prosjektet.
# Prosjektet er bygget slik at det ikke trenger den i det hele tatt.
# Service role-nøkkelen omgår all sikkerhet i databasen, og havner den i en
# variabel med NEXT_PUBLIC_ foran, blir den synlig for alle besøkende.
# =============================================================================
